# Demo hotel: a rollout of the hospitality domain. Only what differs from the domain and core
# defaults goes here (the domain already books hotel services in 30-minute slots).
# `frontdesk-api rollout validate rollouts/demo-hotel` prints every effective setting.
PROVIDER_ID=demo-hotel
DOMAIN_PACK=hospitality

TENANT_TIMEZONE=Asia/Kolkata
TENANT_COUNTRY_CALLING_CODE=91
TENANT_PHONE_PATTERN=^[0-9]{10}$
TENANT_CURRENCY=INR
TENANT_SUPPORTED_LANGUAGES=en,hi
