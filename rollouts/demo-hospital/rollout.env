# Demo hospital: a rollout of the healthcare domain. Only what differs from the domain and core
# defaults goes here; `frontdesk-api rollout validate rollouts/demo-hospital` prints every
# effective setting and the layer it comes from. NON-SECRET values only: credentials live in the
# secret store (Azure Key Vault) or the local .env. Read with docker --env-file or a line reader,
# never `source` (it strips JSON quotes).
PROVIDER_ID=demo-hospital
DOMAIN_PACK=healthcare

# Identity: required, never defaulted
TENANT_TIMEZONE=Asia/Kolkata
TENANT_COUNTRY_CALLING_CODE=91
TENANT_PHONE_PATTERN=^[0-9]{10}$
TENANT_CURRENCY=INR
TENANT_SUPPORTED_LANGUAGES=en,kn,hi

# Identity and disclosure policy (OPEN-QUESTIONS.md P1–P4): the core defaults are the cautious
# choices (NAME_REQUIRED, no cancel on a spoken number, desk follow-up list on). A provider that
# signs off something else sets it here.
