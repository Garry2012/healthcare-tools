# Demo hospital: tenant settings the MCP adapter reads (non-secret, committed). Credentials and the
# owner service URLs live in the secret store (Azure Key Vault) or the local .env. Read with
# docker --env-file or a line reader (scripts/rollout-env.sh), never `source`.
PROVIDER_ID=demo-hospital
DOMAIN_PACK=healthcare

# Identity: required, never defaulted
TENANT_TIMEZONE=Asia/Kolkata
TENANT_COUNTRY_CALLING_CODE=91
TENANT_SUPPORTED_LANGUAGES=en,kn,hi

# Operation budgets: total deadline / per-exchange cap, in seconds.
# Reads fit the voice share; writes and summaries have independent totals.
READ_DEADLINE_SECONDS=0.30
READ_EXCHANGE_TIMEOUT_SECONDS=0.30
WRITE_DEADLINE_SECONDS=3.0
WRITE_EXCHANGE_TIMEOUT_SECONDS=1.0
SUMMARY_DEADLINE_SECONDS=8.0
SUMMARY_EXCHANGE_TIMEOUT_SECONDS=8.0
