    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Call-end lifecycle only (not for use during the conversation): store the hospital-facing summary of the completed call. Call identity and timing come from the platform. For a callback after UNKNOWN availability use outcome CALLBACK_NOTED with the caller's name and callback number.",
      "inputSchema": {
        "properties": {
          "appointmentId": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The appointment created or changed, when applicable."
          },
          "callerMobile": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The 10-digit callback number only when the caller gave it; never the caller ID."
          },
          "callerName": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The caller's name when they gave it (required for CALLBACK_NOTED)."
          },
          "doctorId": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The doctor the call was about, when applicable."
          },
          "intent": {
            "description": "What the caller wanted.",
            "enum": [
              "AVAILABILITY",
              "BOOKING",
              "RESCHEDULE",
              "CANCEL",
              "GENERAL_INFO",
              "LAB",
              "INSURANCE",
              "EMERGENCY",
              "AMBULANCE",
              "SYMPTOM_ROUTING",
              "COMPLAINT",
              "ADMIN",
              "OTHER"
            ],
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "maxLength": 16,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The language the call was handled in."
          },
          "outcome": {
            "description": "How the call ended from the hospital's point of view.",
            "enum": [
              "RESOLVED_BY_AGENT",
              "APPOINTMENT_NOTED",
              "APPOINTMENT_CANCELLED",
              "APPOINTMENT_RESCHEDULED",
              "TRANSFERRED",
              "EMERGENCY_TRANSFERRED",
              "AMBULANCE_NUMBER_GIVEN",
              "CALLBACK_NOTED",
              "ABANDONED"
            ],
            "type": "string"
          },
          "requestedDate": {
            "anyOf": [
              {
                "maxLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
