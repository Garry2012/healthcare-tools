              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For CALLBACK_NOTED: the date the caller asked about (YYYY-MM-DD), kept whole in the summary."
          },
          "summaryText": {
            "description": "One or two sentences for the admin UI; never a transcript.",
            "maxLength": 2000,
            "type": "string"
          },
          "transferredTo": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Desk or department the call was handed to, for transfer outcomes."
          }
        },
        "required": [
          "intent",
          "outcome",
          "summaryText"
        ],
        "type": "object"
      },
      "lifecycle": true,
      "name": "record_call_summary",
      "outputSchema": {
        "properties": {
