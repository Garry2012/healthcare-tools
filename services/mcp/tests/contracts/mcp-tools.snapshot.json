    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Record (CREATE), list (LIST), cancel (CANCEL) or move (RESCHEDULE) an appointment request. CREATE needs the patient's name and mobile read back, the chosen doctorId or departmentId, the confirmed visit date and optional preferred time; success is NOTED (recorded, not a reserved time). LIST, CANCEL and RESCHEDULE work on the verified caller's own number only. Every write needs callerConfirmed=true after reading the details back.",
      "inputSchema": {
        "properties": {
          "action": {
            "description": "CREATE a request, LIST the caller's requests, CANCEL or RESCHEDULE one of them.",
            "enum": [
              "CREATE",
              "LIST",
              "CANCEL",
              "RESCHEDULE"
            ],
            "type": "string"
          },
          "appointmentId": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CANCEL/RESCHEDULE: the appointmentId from LIST or CREATE."
          },
          "callerConfirmed": {
            "default": false,
            "description": "true only after the caller clearly agreed to the read-back details.",
            "type": "boolean"
          },
          "departmentId": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the chosen departmentId when no particular doctor was chosen."
          },
          "doctorId": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the chosen doctorId from get_doctor_availability (or departmentId instead)."
          },
          "fromDate": {
            "anyOf": [
              {
                "maxLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "newPreferredTime": {
            "anyOf": [
              {
                "maxLength": 5,
                "pattern": "^\\d{2}:\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "RESCHEDULE: the new preferred time, HH:MM, if given."
          },
          "newVisitDate": {
            "anyOf": [
              {
                "maxLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "RESCHEDULE: the new confirmed date, YYYY-MM-DD."
          },
          "patientMobile": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the patient's 10-digit mobile, read back digit by digit. Contact data only."
          },
          "patientName": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the patient's name, spelled back."
          },
          "preferredTime": {
            "anyOf": [
              {
                "maxLength": 5,
                "pattern": "^\\d{2}:\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the time the caller would like to come, HH:MM 24-hour, if they gave one."
          },
          "reasonVerbatim": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE/CANCEL: the caller's own words for the reason. Never an interpretation."
          },
          "session": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the board session the caller chose from get_doctor_availability (e.g. Morning), when the doctor has several that day."
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "NOTED",
                  "CONFIRMED_BY_DESK",
                  "CHANGED",
                  "CANCELLED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "toDate": {
            "anyOf": [
              {
                "maxLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "visitDate": {
            "anyOf": [
              {
                "maxLength": 10,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CREATE: the confirmed visit date, YYYY-MM-DD."
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
