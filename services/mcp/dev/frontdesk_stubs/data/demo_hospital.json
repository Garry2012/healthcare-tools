  "answers": [
    {"id": "kb_opd_hours", "questions": ["opd timings", "what time does the hospital open", "hospital timings", "opd kab khulta hai", "hospital kab khulta hai", "ಆಸ್ಪತ್ರೆ ಎಷ್ಟು ಗಂಟೆಗೆ ತೆರೆಯುತ್ತದೆ", "अस्पताल कितने बजे खुलता है"],
     "answers": {"en": "The outpatient department is open every day, 9 AM to 8 PM. Emergency is open all day, every day.", "kn": "ಹೊರರೋಗಿ ವಿಭಾಗ ಪ್ರತಿದಿನ ಬೆಳಿಗ್ಗೆ 9 ರಿಂದ ರಾತ್ರಿ 8 ರವರೆಗೆ ತೆರೆದಿರುತ್ತದೆ. ತುರ್ತು ವಿಭಾಗ ದಿನದ 24 ಗಂಟೆಯೂ ತೆರೆದಿರುತ್ತದೆ.", "hi": "ओपीडी हर दिन सुबह 9 बजे से रात 8 बजे तक खुली रहती है। इमरजेंसी चौबीसों घंटे खुली रहती है।"}},
    {"id": "kb_visiting_hours", "questions": ["visiting hours", "visiting time", "when can i visit a patient", "patient se milne ka time", "ರೋಗಿಯನ್ನು ನೋಡಲು ಸಮಯ", "मरीज़ से मिलने का समय"],
     "answers": {"en": "Ward visiting hours are 11 AM to 12 noon and 5 PM to 7 PM. One visitor per patient at a time.", "kn": "ವಾರ್ಡ್ ಭೇಟಿ ಸಮಯ ಬೆಳಿಗ್ಗೆ 11 ರಿಂದ 12 ಮತ್ತು ಸಂಜೆ 5 ರಿಂದ 7. ಒಂದು ಬಾರಿಗೆ ಒಬ್ಬ ರೋಗಿಗೆ ಒಬ್ಬರು ಮಾತ್ರ.", "hi": "वार्ड में मिलने का समय सुबह 11 से 12 और शाम 5 से 7 बजे है। एक समय में एक मरीज़ के पास एक ही व्यक्ति।"}},
    {"id": "kb_parking", "questions": ["parking", "is there parking", "where do i park", "gaadi kahan park karein", "ಪಾರ್ಕಿಂಗ್ ಇದೆಯಾ", "पार्किंग है क्या"],
     "answers": {"en": "Yes. Free parking is in the basement; enter from the side road next to the main gate.", "kn": "ಹೌದು. ನೆಲಮಾಳಿಗೆಯಲ್ಲಿ ಉಚಿತ ಪಾರ್ಕಿಂಗ್ ಇದೆ; ಮುಖ್ಯ ದ್ವಾರದ ಪಕ್ಕದ ರಸ್ತೆಯಿಂದ ಒಳಗೆ ಬನ್ನಿ.", "hi": "हाँ। बेसमेंट में मुफ़्त पार्किंग है; मुख्य गेट के बगल वाली सड़क से अंदर आइए।"}},
    {"id": "kb_payment", "questions": ["payment methods", "do you accept upi", "can i pay by card", "card chalega", "upi chalega", "ಕಾರ್ಡ್ ತೆಗೆದುಕೊಳ್ಳುತ್ತೀರಾ", "कार्ड से पेमेंट"],
     "answers": {"en": "We accept cash, UPI, and debit or credit cards at the billing counter.", "kn": "ಬಿಲ್ಲಿಂಗ್ ಕೌಂಟರ್‌ನಲ್ಲಿ ನಗದು, ಯುಪಿಐ ಮತ್ತು ಡೆಬಿಟ್ ಅಥವಾ ಕ್ರೆಡಿಟ್ ಕಾರ್ಡ್ ತೆಗೆದುಕೊಳ್ಳುತ್ತೇವೆ.", "hi": "बिलिंग काउंटर पर नकद, यूपीआई और डेबिट या क्रेडिट कार्ड लिए जाते हैं।"}},
    {"id": "kb_location", "questions": ["where is the hospital", "address", "how to reach", "hospital kahan hai", "ಆಸ್ಪತ್ರೆ ಎಲ್ಲಿದೆ", "अस्पताल कहाँ है"],
     "answers": {"en": "We are at 12 Example Road, next to the City Bus Stand. I can send the location by SMS if you like.", "kn": "ನಾವು 12 ಎಕ್ಸಾಂಪಲ್ ರಸ್ತೆ, ನಗರ ಬಸ್ ನಿಲ್ದಾಣದ ಪಕ್ಕದಲ್ಲಿದ್ದೇವೆ.", "hi": "हम 12 एग्ज़ाम्पल रोड पर, सिटी बस स्टैंड के बगल में हैं।"}},
    {"id": "kb_insurance", "questions": ["do you take insurance", "cashless", "is my insurance accepted", "insurance chalega", "ವಿಮೆ ತೆಗೆದುಕೊಳ್ಳುತ್ತೀರಾ", "बीमा चलेगा"],
     "answers": {"en": "Cashless insurance depends on your insurer and policy. I will connect you to the insurance desk.", "kn": "ಕ್ಯಾಶ್‌ಲೆಸ್ ವಿಮೆ ನಿಮ್ಮ ವಿಮಾ ಕಂಪನಿಯ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿದೆ. ನಾನು ನಿಮ್ಮನ್ನು ವಿಮಾ ವಿಭಾಗಕ್ಕೆ ಸಂಪರ್ಕಿಸುತ್ತೇನೆ.", "hi": "कैशलेस बीमा आपकी बीमा कंपनी और पॉलिसी पर निर्भर है। मैं आपको इंश्योरेंस डेस्क से जोड़ता हूँ।"},
     "outcome": "DESK_TRANSFER", "destination": "insurance"},
    {"id": "kb_cancel_policy", "questions": ["is there a cancellation fee", "cancel charges", "cancel karne ka charge", "ರದ್ದು ಮಾಡಿದರೆ ಶುಲ್ಕ ಇದೆಯಾ", "कैंसल करने का चार्ज"],
     "answers": {"en": "There is no charge to cancel or move an appointment. Please let us know as early as you can.", "kn": "ಅಪಾಯಿಂಟ್‌ಮೆಂಟ್ ರದ್ದು ಮಾಡಲು ಅಥವಾ ಬದಲಿಸಲು ಯಾವುದೇ ಶುಲ್ಕ ಇಲ್ಲ.", "hi": "अपॉइंटमेंट कैंसल करने या बदलने का कोई चार्ज नहीं है। कृपया जितनी जल्दी हो सके बताइए।"}},
    {"id": "kb_clarify_fee", "questions": ["how much does it cost", "fees kitna hai", "ಫೀಸ್ ಎಷ್ಟು", "फीस कितनी है"],
