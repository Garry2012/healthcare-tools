# Copy to .env and fill in. `.env` is git-ignored; never commit populated values.
# The Makefile and docker compose read this file; the services read only their environment.
ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (local docker) --------------------------------------------
POSTGRES_DB=frontdesk
POSTGRES_OWNER_USER=frontdesk_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
APP_DB_USER=frontdesk_app
APP_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=55432
TEST_POSTGRES_HOST_PORT=55433

# --- frontdesk-api ---------------------------------------------------------
API_HOST_PORT=8000
# token -> scopes. The first is the voice agent (used by frontdesk-mcp); the second is staff.
AUTH_TOKENS_JSON='{"change-me-agent-token":["agent"],"change-me-staff-token":["bookings.staff","schedule.write","board.write","directory.write","calls.write","calls.read"]}'

# Tenant (IMPLEMENTATION.md §2.9). Defaults shown; uncomment to override.
TENANT_TIMEZONE=Asia/Kolkata
TENANT_COUNTRY_CALLING_CODE=91
# TENANT_PHONE_PATTERN=^[0-9]{10}$ (default; set in the service environment, not via compose)
TENANT_CURRENCY=INR
# TENANT_DAY_PARTS_JSON='{"MORNING":["06:00","12:00"],"AFTERNOON":["12:00","16:00"],"EVENING":["16:00","23:00"]}'
# TENANT_DEFAULT_CAPACITY=12
# TENANT_LAST_ARRIVAL_OFFSET_MINUTES=15
# TENANT_WALK_IN_RESERVE_PERCENT=0
# TENANT_RESOLVER_RESOURCE_THRESHOLD=0.8
# TENANT_RESOLVER_CATEGORY_THRESHOLD=0.8
# TENANT_RESOLVER_SUGGESTION_CUTOFF=0.7
TENANT_DISCLOSURE_POLICY=NAME_REQUIRED
TENANT_CANCEL_ON_SPOKEN_NUMBER=false
# TENANT_TRANSFER_DESTINATIONS_JSON='{"emergency":"Emergency","desk":"Front desk","lab":"Laboratory","pharmacy":"Pharmacy","insurance":"Insurance desk"}'

# --- frontdesk-mcp ---------------------------------------------------------
MCP_HOST_PORT=8100
# Bearer the MCP adapter presents to the API (must be an `agent` token above).
API_BEARER_TOKEN=change-me-agent-token
# Bearer ContextForge presents to the MCP adapter.
MCP_BEARER_TOKEN=change-me-mcp-token
# Dev only: used when the gateway forwards no X-Caller-Number. Refused when ENV=production.
MCP_DEV_CALLER_NUMBER=

# --- ContextForge registration (deploy/contextforge/register.py) -------------
CONTEXTFORGE_URL=http://127.0.0.1:4444
CONTEXTFORGE_ADMIN_EMAIL=
CONTEXTFORGE_ADMIN_PASSWORD=
MCP_PUBLIC_URL=http://frontdesk-mcp:8100/mcp/
