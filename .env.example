# Copy to .env and fill in. `.env` is git-ignored; never commit populated values.
# The Makefile and docker compose read this file; the adapter reads only its environment.
ENV=development
LOG_LEVEL=INFO

# The rollout (a provider's tenant settings) lives in rollouts/$PROVIDER_ID/rollout.env (non-secret, committed).
PROVIDER_ID=demo-hospital

# --- Manoj's operational API (full base URL: the backend serves under /api/v1, the public mock does not) ---
# `make up` points the adapter at the local stub (http://ops-stub:8200/api/v1) unless COMPOSE_OPS_BASE_URL is set.
# Owner endpoints for tests/deploy come from `scripts/env.sh <profile>`, never from this file.
COMPOSE_OPS_BASE_URL=
# Machine client registered with the operational API (scopes appointments.write, calls.write). For the stubs,
# any pair works: the stub registers exactly these values at start-up.
OPS_CLIENT_ID=mcp-dev
OPS_CLIENT_SECRET=change-me-ops-secret

# Scheduling works without a knowledge provider; search_knowledge then reports NOT_CONFIGURED.
# Production profiles may leave KNOWLEDGE_BASE_URL blank; configured hosts must be HTTPS and non-mock.
# --- Shobhit's knowledge service (contract pending; see services/mcp/src/frontdesk_mcp/knowledge_contract.py) ---
# `make up` uses the local stub (http://knowledge-stub:8300) unless COMPOSE_KNOWLEDGE_BASE_URL is set.
COMPOSE_KNOWLEDGE_BASE_URL=
KNOWLEDGE_BEARER_TOKEN=change-me-knowledge-secret

# --- frontdesk-mcp -------------------------------------------------------------------------------
# Voice budget → in-call tool deadline (read AND confirmed write) = budget − reserved − gateway = 0.30 s.
# Explicit READ_DEADLINE_SECONDS/WRITE_DEADLINE_SECONDS above that share are refused unless
# ALLOW_BUDGET_OVERRIDES=true (diagnostics only, never production). Summaries run after the call (8 s).
VOICE_RESPONSE_BUDGET_SECONDS=1.0
RESERVED_STAGE_SECONDS=0.65
GATEWAY_OVERHEAD_SECONDS=0.05
ALLOW_BUDGET_OVERRIDES=false
# Which X-Caller-Verification assertions authorise appointment lookups/changes (agreed with Manoj and the platform).
ACCEPTED_CALLER_VERIFICATION=SIP_CALLER_ID
MCP_HOST_PORT=8100
OPS_STUB_HOST_PORT=8200
KNOWLEDGE_STUB_HOST_PORT=8300
# Bearer the gateway (ContextForge / voice agent) presents for the three conversational tools.
MCP_BEARER_TOKEN=change-me-mcp-token
# Bearer the call-end lifecycle presents for record_call_summary. Must differ from MCP_BEARER_TOKEN.
MCP_LIFECYCLE_BEARER_TOKEN=change-me-lifecycle-token
# Dev only: used when the gateway forwards no X-Caller-Number. Refused when ENV=production.
MCP_DEV_CALLER_NUMBER=

# --- ContextForge registration (deploy/contextforge/register.py) ------------------------------------
CONTEXTFORGE_URL=http://127.0.0.1:4444
CONTEXTFORGE_ADMIN_EMAIL=
CONTEXTFORGE_ADMIN_PASSWORD=
MCP_PUBLIC_URL=http://frontdesk-mcp:8100/mcp/
