# Provider configuration: one file per hospital (or hotel), one deployment each
# (docs/architecture/TARGET.md A1). NON-SECRET values only — credentials stay in .env / the
# secret store. Validate before deploying:
#   docker run --rm --env-file deploy/providers/demo-hospital.env frontdesk-api frontdesk-api check-config
PROVIDER_ID=demo-hospital
DOMAIN_PACK=healthcare

TENANT_TIMEZONE=Asia/Kolkata
TENANT_COUNTRY_CALLING_CODE=91
TENANT_PHONE_PATTERN=^[0-9]{10}$
TENANT_CURRENCY=INR
TENANT_SUPPORTED_LANGUAGES=en,kn,hi
TENANT_DAY_PARTS_JSON={"MORNING":["06:00","12:00"],"AFTERNOON":["12:00","16:00"],"EVENING":["16:00","23:00"]}

# Capacity and booking rules
TENANT_DEFAULT_CAPACITY=12
TENANT_LAST_ARRIVAL_OFFSET_MINUTES=15
TENANT_WALK_IN_RESERVE_PERCENT=0
TENANT_SEQUENCE_WINDOW_MINUTES=20
TENANT_DEFAULT_SLOT_MINUTES=15
TENANT_SEARCH_DEFAULT_DAYS=7
TENANT_NEXT_BOOKABLE_HORIZON_DAYS=14

# Understanding: below these the agent asks instead of guessing
TENANT_RESOLVER_RESOURCE_THRESHOLD=0.8
TENANT_RESOLVER_CATEGORY_THRESHOLD=0.8
TENANT_RESOLVER_SUGGESTION_CUTOFF=0.7
TENANT_KNOWLEDGE_ANSWER_THRESHOLD=0.6
TENANT_KNOWLEDGE_CLARIFY_THRESHOLD=0.35

# Identity and disclosure policy (OPEN-QUESTIONS.md P1–P4: the provider must sign these off)
TENANT_DISCLOSURE_POLICY=NAME_REQUIRED
TENANT_CANCEL_ON_SPOKEN_NUMBER=false
TENANT_DESK_FOLLOW_UP_LIST_ENABLED=true

# Empty = the domain pack's destinations. Keys must cover the pack's escalation destination.
TENANT_TRANSFER_DESTINATIONS_JSON=
