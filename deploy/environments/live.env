# Manoj's live operational API. Fill OPS_BASE_URL with the FULL base he supplies (the deployed backend serves
# under /api/v1: e.g. https://<host>/api/v1). Status: awaiting live integration — scripts/env.sh refuses this
# profile while the value is blank, so nothing can silently point at a guessed host.
PROFILE=live
OPS_BASE_URL=
OPS_E2E_MODE=live
OPS_CLIENT_ID_SECRET_NAME=ops-client-id
OPS_CLIENT_SECRET_SECRET_NAME=ops-client-secret
