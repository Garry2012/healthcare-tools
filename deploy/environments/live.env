# Manoj's live operational API (healthcare-rg, Medplum-backed). The FULL base including /api/v1, supplied by
# Manoj on 2 October 2026. Change the endpoint here and nowhere else: deployment, the external gates and the
# benchmark all read it through scripts/env.sh. Credentials stay in Key Vault (names below), never here.
PROFILE=live
OPS_BASE_URL=https://healthcare-api.icytree-6543aaa9.centralindia.azurecontainerapps.io/api/v1
OPS_E2E_MODE=live
OPS_CLIENT_ID_SECRET_NAME=ops-client-id
OPS_CLIENT_SECRET_SECRET_NAME=ops-client-secret
# Shobhit's knowledge service: fill when his contract/host exists.
KNOWLEDGE_BASE_URL=
AZ_SUBSCRIPTION_ID=4e1c081a-9a6a-4e16-9da2-90217c22378b
AZ_RESOURCE_GROUP=healthcare-rg
AZ_CONTAINERAPPS_ENV=cae-frontdesk-demo-hospital
AZ_LOG_WORKSPACE=law-frontdesk-demo-hospital
AZ_ACR=acrfd399536
AZ_KEYVAULT=kv-fd-demo-hospi-0574c1
AZ_IDENTITY=id-frontdesk-demo-hospital
# Deploy the new adapter as a CANARY app first: voice-api/voice-worker still call mcp-demo-hospital with the legacy
# tool names and without the trusted headers, so upgrading it in place would break them. Point the voice platform
# at the canary once it forwards the headers; retire/rename afterwards (AZURE-RETIREMENT-RESULTS.md).
AZ_MCP_APP=mcp-demo-hospital-canary
